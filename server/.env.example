PORT=3001
NODE_ENV=development

# Use the same project URL and publishable/anon key as the web app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secret from Supabase Settings -> API. Never add it to Vercel or
# any VITE_ variable. It enables game persistence and trusted rating updates.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Comma-separated browser origins. Set the real HTTPS site URL in production.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
