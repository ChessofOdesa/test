PORT=3001
NODE_ENV=development

# Use the same project URL and publishable/anon key as the web app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only key from Supabase Settings -> API Keys. Never add it to Vercel or
# any VITE_ variable. Prefer a new sb_secret_ key; the legacy service-role key
# remains supported through SUPABASE_SERVICE_ROLE_KEY during migration.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Comma-separated browser origins. Set the real HTTPS site URL in production.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
