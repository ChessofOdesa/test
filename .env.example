VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# Required in production. For local development the app defaults to ws://localhost:3001.
VITE_ONLINE_WS_URL="ws://localhost:3001"

